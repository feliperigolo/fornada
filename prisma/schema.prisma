// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  password      String
  image         String?
  bakeries      Bakery[]  @relation("OwnerBakeries")
  createdAt     DateTime  @default(now())
}

model Bakery {
  id          String       @id @default(uuid())
  name        String
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], name: "OwnerBakeries")
  categories  Category[]
  products    Product[]
  ingredients Ingredient[]
  fixedCosts  FixedCost[]
  nfeImports  NfeImport[]
  createdAt   DateTime     @default(now())
}

model Category {
  id       String    @id @default(uuid())
  name     String
  bakeryId String
  bakery   Bakery    @relation(fields: [bakeryId], references: [id])
  products Product[]
}

model Product {
  id         String    @id @default(uuid())
  name       String
  sku        String?   @unique
  bakeryId   String
  bakery     Bakery    @relation(fields: [bakeryId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  sellPrice  Decimal   @db.Decimal(10, 2)
  recipes    Recipe[]
  createdAt  DateTime  @default(now())
}

model Ingredient {
  id            String             @id @default(uuid())
  name          String
  unit          String
  costPerUnit   Decimal            @db.Decimal(14, 6)
  stockQuantity Decimal?           @db.Decimal(14, 3)
  bakeryId      String
  bakery        Bakery             @relation(fields: [bakeryId], references: [id])
  costHistory   CostHistory[]
  recipeItems   RecipeIngredient[]
  nfeItems      NfeItem[]
  createdAt     DateTime           @default(now())
}

model Recipe {
  id          String             @id @default(uuid())
  productId   String
  product     Product            @relation(fields: [productId], references: [id])
  yieldAmount Decimal?           @db.Decimal(14, 3)
  notes       String?
  ingredients RecipeIngredient[]
  createdAt   DateTime           @default(now())
}

model RecipeIngredient {
  id           String     @id @default(uuid())
  recipeId     String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 6)
  unit         String
  recipe       Recipe     @relation(fields: [recipeId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
}

model FixedCost {
  id        String    @id @default(uuid())
  bakeryId  String
  bakery    Bakery    @relation(fields: [bakeryId], references: [id])
  name      String
  amount    Decimal   @db.Decimal(12, 2)
  monthly   Boolean   @default(true)
  startDate DateTime?
}

model CostHistory {
  id           String     @id @default(uuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  unitCost     Decimal    @db.Decimal(14, 6)
  recordedAt   DateTime   @default(now())
}

model NfeImport {
  id         String    @id @default(uuid())
  bakeryId   String
  bakery     Bakery    @relation(fields: [bakeryId], references: [id])
  supplier   String?
  nfNumber   String?
  xmlRaw     String    @db.Text
  items      NfeItem[]
  importedAt DateTime  @default(now())
}

model NfeItem {
  id           String      @id @default(uuid())
  nfeImportId  String
  nfeImport    NfeImport   @relation(fields: [nfeImportId], references: [id])
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
  code         String?
  name         String
  quantity     Decimal     @db.Decimal(14, 6)
  unit         String?
  unitCost     Decimal     @db.Decimal(14, 6)
  totalCost    Decimal     @db.Decimal(14, 6)
}