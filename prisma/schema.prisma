// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
}

enum CostType {
  FIXED
  VARIABLE
  LOAN
}

enum Recurrence {
  MONTHLY
  ANNUAL
  ONETIME
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  password      String
  role          Role      @default(OWNER)
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  bakeries      Bakery[]  @relation("OwnerBakeries")
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Bakery {
  id              String           @id @default(uuid())
  name            String
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id], name: "OwnerBakeries")
  categories      Category[]
  products        Product[]
  ingredients     Ingredient[]
  recipes         Recipe[]
  costs           Cost[]
  nfeImports      NfeImport[]
  monthlyRevenues MonthlyRevenue[]
  createdAt       DateTime         @default(now())
}

model Category {
  id       String    @id @default(uuid())
  name     String
  bakeryId String
  bakery   Bakery    @relation(fields: [bakeryId], references: [id])
  products Product[]
}

model Product {
  id         String    @id @default(uuid())
  name       String
  sku        String?   @unique
  bakeryId   String
  bakery     Bakery    @relation(fields: [bakeryId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  sellPrice  Decimal   @db.Decimal(10, 2)
  recipes    Recipe[]
  createdAt  DateTime  @default(now())
}

model Ingredient {
  id            String        @id @default(uuid())
  name          String
  unit          String
  costPerUnit   Decimal       @db.Decimal(14, 6)
  stockQuantity Decimal?      @db.Decimal(14, 3)
  bakeryId      String
  bakery        Bakery        @relation(fields: [bakeryId], references: [id])
  costHistory   CostHistory[]
  recipeItems   RecipeItem[]
  nfeItems      NfeItem[]
  createdAt     DateTime      @default(now())
}

// A recipe may stand alone (e.g. a base dough used by other recipes); productId is optional.
model Recipe {
  id        String       @id @default(uuid())
  name      String
  bakeryId  String
  bakery    Bakery       @relation(fields: [bakeryId], references: [id])
  productId String?
  product   Product?     @relation(fields: [productId], references: [id])
  yieldQty  Decimal?     @db.Decimal(14, 3)
  yieldUnit String?
  notes     String?
  items     RecipeItem[] @relation("RecipeItems")
  usedIn    RecipeItem[] @relation("SubRecipe")
  createdAt DateTime     @default(now())
}

// Exactly one of ingredientId / subRecipeId must be set (enforced by CHECK in the migration SQL).
model RecipeItem {
  id           String      @id @default(uuid())
  recipeId     String
  recipe       Recipe      @relation("RecipeItems", fields: [recipeId], references: [id])
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
  subRecipeId  String?
  subRecipe    Recipe?     @relation("SubRecipe", fields: [subRecipeId], references: [id])
  quantity     Decimal     @db.Decimal(14, 6)
  unit         String
}

model Cost {
  id         String     @id @default(uuid())
  bakeryId   String
  bakery     Bakery     @relation(fields: [bakeryId], references: [id])
  name       String
  amount     Decimal    @db.Decimal(12, 2)
  type       CostType   @default(FIXED)
  recurrence Recurrence @default(MONTHLY)
  startDate  DateTime?
  /// Primeiro dia (UTC) do mês de competência do lançamento.
  month      DateTime

  @@index([bakeryId, month])
}

model MonthlyRevenue {
  id           String   @id @default(uuid())
  bakeryId     String
  bakery       Bakery   @relation(fields: [bakeryId], references: [id])
  month        DateTime
  grossRevenue Decimal  @db.Decimal(12, 2)
  source       String?
  xmlRaw       String?  @db.Text
  createdAt    DateTime @default(now())
}

model CostHistory {
  id           String     @id @default(uuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  unitCost     Decimal    @db.Decimal(14, 6)
  recordedAt   DateTime   @default(now())
}

model NfeImport {
  id         String    @id @default(uuid())
  bakeryId   String
  bakery     Bakery    @relation(fields: [bakeryId], references: [id])
  supplier   String?
  nfNumber   String?
  xmlRaw     String    @db.Text
  items      NfeItem[]
  importedAt DateTime  @default(now())
}

model NfeItem {
  id           String      @id @default(uuid())
  nfeImportId  String
  nfeImport    NfeImport   @relation(fields: [nfeImportId], references: [id])
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
  code         String?
  name         String
  quantity     Decimal     @db.Decimal(14, 6)
  unit         String?
  unitCost     Decimal     @db.Decimal(14, 6)
  totalCost    Decimal     @db.Decimal(14, 6)
}
